# Auth
AUTH_USERNAME="username"
AUTH_PASSWORD_HASH="xxx"
AUTH_PEPPER="xxx"

JWT_SECRET="xxx"
COOKIE_DOMAIN=""

THROTTLE_TTL=60000
THROTTLE_LIMIT=5
